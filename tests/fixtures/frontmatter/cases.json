{
 "about": "Shared task-file contract fixtures (R2-22, rule 13). Run by tests/run_tests.py (group r222) and android/core unit tests; both must produce byte-identical output.",
 "rules": [
  "Each edit applies to the original file on its own (not chained).",
  "remove/replace an entry the file does not have → \"gone\" (nothing written).",
  "expect null → the line-level edit refuses (no frontmatter, two remind keys, a value it cannot read); the caller must not write. For parsed.unreadable / parsed.noFrontmatter cases, apply the op to an empty list.",
  "parsed.remindLine (when present) is what the line-level reader gives where it differs from YAML (null = unreadable value)."
 ],
 "cases": [
  {
   "name": "crlf-scalar",
   "file": "crlf-scalar.md",
   "parsed": {
    "id": "t-20261114-crlf",
    "title": "Pay rent",
    "status": "open",
    "due": "2026-11-14",
    "remind": [
     "2026-11-14 17:00"
    ],
    "remind_text": "",
    "repeat": ""
   },
   "edits": [
    {
     "op": "remove",
     "entry": "2026-11-14 17:00",
     "expect": "crlf-scalar.1.md"
    },
    {
     "op": "replace",
     "entry": "2026-11-14 17:00",
     "to": "2026-11-14 17:10",
     "expect": "crlf-scalar.2.md"
    },
    {
     "op": "add",
     "to": "2026-11-14 09:00",
     "expect": "crlf-scalar.3.md"
    }
   ]
  },
  {
   "name": "odd-order-list",
   "file": "odd-order-list.md",
   "parsed": {
    "id": "t-20261114-odd",
    "title": "Water the plants",
    "status": "active",
    "due": "2026-11-15",
    "remind": [
     "2026-11-15 08:00",
     "2026-11-14 18:30"
    ],
    "remind_text": "",
    "repeat": ""
   },
   "edits": [
    {
     "op": "remove",
     "entry": "2026-11-14 18:30",
     "expect": "odd-order-list.1.md"
    },
    {
     "op": "replace",
     "entry": "2026-11-15 08:00",
     "to": "2026-11-14 08:00",
     "expect": "odd-order-list.2.md"
    },
    {
     "op": "add",
     "to": "2026-11-16 08:00",
     "expect": "odd-order-list.3.md"
    }
   ]
  },
  {
   "name": "quoted",
   "file": "quoted.md",
   "parsed": {
    "id": "t-20261114-quo",
    "title": "Call: the dentist",
    "status": "open",
    "due": "2026-11-20",
    "remind": [
     "2026-11-19 09:00"
    ],
    "remind_text": "Call the dentist, it's about the crown",
    "repeat": "yearly"
   },
   "edits": [
    {
     "op": "remove",
     "entry": "2026-11-19 09:00",
     "expect": "quoted.1.md"
    },
    {
     "op": "add",
     "to": "2026-11-20 08:00",
     "expect": "quoted.2.md"
    },
    {
     "op": "replace",
     "entry": "2026-11-19 09:00",
     "to": "2026-11-19 10:00",
     "expect": "quoted.3.md"
    }
   ]
  },
  {
   "name": "bom",
   "file": "bom.md",
   "parsed": {
    "id": "t-20261114-bom",
    "title": "Notepad file",
    "status": "open",
    "due": "2026-12-01",
    "remind": [],
    "remind_text": "",
